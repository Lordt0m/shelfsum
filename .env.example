# Local development uses the explicit SQLite defaults in config.settings.
SHELFSUM_ENV=development

# Required only when SHELFSUM_ENV=production; use a secret value outside source control.
SECRET_KEY=replace-with-a-random-production-secret
DATABASE_URL=postgresql://user:password@host:5432/database

# Render supplies RENDER_EXTERNAL_HOSTNAME automatically. Set these only when using
# another provider or a custom hostname, and keep every origin on HTTPS.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
